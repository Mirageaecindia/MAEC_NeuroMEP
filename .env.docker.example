# Docker settings (compose.yaml). Copy to .env.docker, fill in, never commit .env.docker.
#   docker compose --env-file .env.docker up -d --build
# Passwords go into a connection string: use letters, digits, "-" and "_" only, e.g.
#   openssl rand -hex 24

# MongoDB administrator (kept for backups / maintenance; the API does not use it)
MONGO_ROOT_USERNAME=root
MONGO_ROOT_PASSWORD=
# Account the API uses: read / write on the NeuroMEP database only
MONGO_APP_USERNAME=neuromep
MONGO_APP_PASSWORD=
MONGODB_DB=neuromep

# Public side of the web container
SERVER_NAME=_
HTTP_PORT=80
HTTPS_PORT=443
# Session cookies need HTTPS. Only for a test server reached over plain http://<ip>: false
COOKIE_SECURE=true

# Image tag (neuromep-web / neuromep-api / neuromep-db)
NEUROMEP_TAG=latest

# Staging build only: account shown in the login page's "Demo Credentials" line
VITE_DEMO_EMAIL=
VITE_DEMO_PASSWORD=
