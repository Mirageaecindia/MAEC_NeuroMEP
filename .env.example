# Copy to .env and fill in. Never commit .env.
# MongoDB connection string (Atlas in shared environments, local mongod for development)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=neuromep
# API port; the web dev server proxies /api to it
API_PORT=4000
# Authentication provider: "config" (user file with password hashes) until OI-28 decides the company login
AUTH_PROVIDER=config
# User file (JSON: id, name, email, role, passwordHash). Required in production; development uses
# apps/api/config/users.dev.json. Hash a password with: npm run hash-password -w @neuromep/api
# USERS_FILE=/etc/neuromep/users.json
# Web build: account shown in the login page's "Demo Credentials" line (staging only; development
# always shows the seeded Technical Lead)
# VITE_DEMO_EMAIL=
# VITE_DEMO_PASSWORD=
