# Copy to .env and fill in. Never commit .env.
# MongoDB connection string (Atlas in shared environments, local mongod for development)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=neuromep
# API port; the web dev server proxies /api to it
API_PORT=4000
# Authentication provider: "dev" (seeded users) until OI-28 decides the real provider
AUTH_PROVIDER=dev
# Web: show the demo-credentials hint on the login page (development only)
VITE_SHOW_DEMO_CREDENTIALS=false
