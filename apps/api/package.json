{
  "name": "@neuromep/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "NeuroMEP API: persistence, rule packs, exports (design doc layer 06).",
  "scripts": {
    "dev": "tsx watch --conditions=source --env-file-if-exists=../../.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=../../.env dist/server.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "hash-password": "tsx --conditions=source src/auth/hash-password.ts"
  },
  "dependencies": {
    "@neuromep/rulepacks": "0.1.0",
    "@neuromep/shared": "0.1.0",
    "express": "^5.3.0",
    "mongodb": "^7.7.0",
    "pdfjs-dist": "^6.4.299",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/supertest": "^7.2.1",
    "mongodb-memory-server": "^11.3.0",
    "supertest": "^7.3.1"
  }
}
