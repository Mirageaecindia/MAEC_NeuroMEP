# HTTPS (certificates mounted in /etc/nginx/certs): port 80 only redirects, apart from /healthz.
# Docker's DNS: the API address is looked up again when its container restarts.
resolver ${RESOLVER} valid=10s ipv6=off;

upstream neuromep_api {
    zone neuromep_api 64k;
    server ${API_UPSTREAM} resolve;
    keepalive 16;
}

server {
    listen 80;
    listen [::]:80;
    server_name ${SERVER_NAME};
    server_tokens off;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # Let's Encrypt HTTP-01 challenges, if certificates are renewed with a webroot.
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host${HTTPS_REDIRECT_SUFFIX}$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ${SERVER_NAME};
    server_tokens off;

    ssl_certificate /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;

    # Sent by every location (headers.conf).
    set $hsts "max-age=31536000";

    include /etc/neuromep/app.conf;
}
